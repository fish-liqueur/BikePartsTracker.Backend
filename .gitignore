# .NET Core build folders
bin/
obj/

# Visual Studio / Visual Studio Code
.vs/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
